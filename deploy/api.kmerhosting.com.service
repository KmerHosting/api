[Unit]
Description=api.kmerhosting.com public API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kmerapi
Group=kmerapi
WorkingDirectory=/opt/api.kmerhosting.com
EnvironmentFile=/etc/api.kmerhosting.com.env
ExecStart=/usr/local/bin/bun run start
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/api.kmerhosting.com

[Install]
WantedBy=multi-user.target
