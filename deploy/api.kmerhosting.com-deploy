#!/usr/bin/env bash
set -Eeuo pipefail

exec 9>/run/lock/api.kmerhosting.com-deploy.lock
flock -n 9 || exit 0

cd /opt/api.kmerhosting.com
runuser -u kmerapi -- git fetch --quiet origin main
current_commit="$(runuser -u kmerapi -- git rev-parse HEAD)"
target_commit="$(runuser -u kmerapi -- git rev-parse origin/main)"
if [[ "$current_commit" == "$target_commit" ]]; then
  exit 0
fi

runuser -u kmerapi -- git merge --ff-only "$target_commit"
runuser -u kmerapi -- /usr/local/bin/bun install --frozen-lockfile
runuser -u kmerapi -- /usr/local/bin/bun test
runuser -u kmerapi -- /usr/local/bin/bun run typecheck
systemctl restart api.kmerhosting.com.service
curl --fail --silent --show-error --retry 10 --retry-delay 1 https://api.kmerhosting.com/health >/dev/null
