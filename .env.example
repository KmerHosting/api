# Required. This key stays on the VPS only; never expose it in a browser or SDK.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# A random 32+ byte secret shared only with the four product edge functions.
KMERHOSTING_GATEWAY_SECRET=

# Public API listener.
HOST=127.0.0.1
PORT=8787
NODE_ENV=production

# Comma-separated browser origins permitted to call the API. Do not use * in production.
CORS_ORIGINS=https://dashboard.kmerhosting.com,https://domain.kmerhosting.com,https://email.kmerhosting.com,https://shared.kmerhosting.com,https://lxc.kmerhosting.com
