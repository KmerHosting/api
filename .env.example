# Required. This key stays on the VPS only; never expose it in a browser or SDK.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# A random 32+ byte secret shared only with the four product edge functions.
KMERHOSTING_GATEWAY_SECRET=

# Public API listener.
HOST=127.0.0.1
PORT=8787
NODE_ENV=production

# Leave empty for the server-to-server API. Do not put customer API keys in browser code.
# If browser access is intentionally added later, use only explicit HTTPS origins.
CORS_ORIGINS=
